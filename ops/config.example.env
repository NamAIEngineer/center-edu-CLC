# Copy to a protected runtime environment. Do not commit real values.
CENTER_EDU_HOST=127.0.0.1
CENTER_EDU_PORT=8000
CENTER_EDU_DB=/var/lib/center-edu/center-edu.sqlite3
CENTER_EDU_SESSION_TTL=28800
# Set to 1 only when HTTPS/TLS is enforced by the deployment proxy.
CENTER_EDU_COOKIE_SECURE=0
# Local/demo only; never use this value for production.
CENTER_EDU_DEMO_PASSWORD=replace-before-first-start
# Explicit production bootstrap is admin-only and requires one of these
# protected sources (or the one-time prompt from --production-bootstrap).
# CENTER_EDU_PRODUCTION=1
# CENTER_EDU_ADMIN_PASSWORD_FILE=/protected/secrets/center-edu-admin-password
# CENTER_EDU_ADMIN_PASSWORD=
# Keep access logs off unless a redacted diagnostic is required.
CENTER_EDU_ACCESS_LOG=0
